# GitHub Inbox Environment Configuration
#
# This app uses Personal Access Token (PAT) authentication only.
# OAuth was removed for security - client secrets cannot be safely stored in frontend.
#
# To create a PAT:
# 1. Go to https://github.com/settings/tokens/new
# 2. Select scopes: notifications, repo, read:user
# 3. Generate and copy the token
# 4. Enter it on the login page

# Optional: GitHub API Base URL (defaults to https://api.github.com)
# VITE_API_BASE_URL=https://api.github.com
